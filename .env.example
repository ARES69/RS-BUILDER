# ---------------------------------------------------------------------------
# RS-BUILDER runtime configuration
# Copy to .env.local and adjust. All variables must be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Routing mode: "browser" (clean URLs, needs server rewrite) or "hash".
VITE_ROUTER_MODE=browser

# Optional: point the workspace demo at a real agent backend.
# When empty, the built-in simulated agent engine is used (no network needed).
VITE_AGENT_API_URL=

# Brand / product
VITE_APP_NAME=RS-BUILDER
VITE_APP_TAGLINE=Hands-on AI that builds the thing
VITE_SUPPORT_EMAIL=hello@rs-builder.app

# ---------------------------------------------------------------------------
# Server-side (agent backend: `npm run server` / Vercel functions).
# These are NOT prefixed with VITE_ and never reach the browser bundle.
# ---------------------------------------------------------------------------

# OpenAI-compatible provider (OpenRouter by default). OPENAI_MODEL=auto-free
# enables live discovery of $0 tool-capable :free models (50 req/day on free
# OpenRouter accounts, resets 00:00 UTC).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=auto-free

# OpenCode Zen — opt-in: anonymous free tier is policy-blocked since Oct 2026
# (403 FreeTierError), so the provider is only enabled with a key.
OPENCODE_API_KEY=
# RSB_ZEN_BASE_URL=https://opencode.ai/zen/v1
# RSB_ZEN_MODELS=

# Free tiers from awesome-free-models (each enabled by its own key):
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Overrides: provider order/subset (comma-separated; `none` = deterministic
# engine only) and an explicit model chain instead of live discovery.
# RSB_PROVIDERS=openrouter,groq
# RSB_LLM_MODEL_CHAIN=

# Protects POST /api/v1/cron (Vercel Cron sends Authorization: Bearer <secret>).
CRON_SECRET=
