# ---------------------------------------------------------------------------
# RS-BUILDER runtime configuration
# Copy to .env.local and adjust. All variables must be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Routing mode: "browser" (clean URLs, needs server rewrite) or "hash".
VITE_ROUTER_MODE=browser

# Optional: point the workspace demo at a real agent backend.
# When empty, the built-in simulated agent engine is used (no network needed).
VITE_AGENT_API_URL=

# Brand / product
VITE_APP_NAME=RS-BUILDER
VITE_APP_TAGLINE=Hands-on AI that builds the thing
VITE_SUPPORT_EMAIL=hello@rs-builder.app
