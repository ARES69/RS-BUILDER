{
  "name": "rs-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RS-BUILDER \u2014 hands-on AI builder. Marketing site + agent workspace demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "qa:shots": "node scripts/qa-shots.mjs",
    "server": "node server/agent-server.mjs",
    "release": "bash scripts/release.sh",
    "test:api": "node scripts/test-api-functions.mjs",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "test:orchestrator": "node scripts/test-orchestrator.mjs",
    "test:sandbox": "node scripts/test-sandbox.mjs",
    "qa:sandbox": "node scripts/qa-sandbox.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/oidc": "^4.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
